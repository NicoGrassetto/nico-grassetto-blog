---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
---

<div class="article-share">
  <button
    class="article-share-button"
    type="button"
    data-share
    data-share-title={title}
    data-share-url={url}
    hidden
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <g transform="rotate(-45 12 12)">
        <path d="M10 8H7a4 4 0 0 0 0 8h3m4-8h3a4 4 0 0 1 0 8h-3M8 12h8" />
      </g>
    </svg>
    <span data-share-label>Share</span>
  </button>
  <span class="share-status" data-share-status role="status" aria-live="polite"></span>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-share]')!;
  const label = button.querySelector<HTMLElement>('[data-share-label]')!;
  const shareStatus = document.querySelector<HTMLElement>('[data-share-status]')!;

  button.hidden = false;
  button.addEventListener('click', async () => {
    button.disabled = true;
    label.textContent = 'Share';
    shareStatus.textContent = '';
    delete shareStatus.dataset.error;
    try {
      if (navigator.share) {
        await navigator.share({
          title: button.dataset.shareTitle!,
          url: button.dataset.shareUrl!,
        });
        shareStatus.textContent = 'Post shared.';
      } else {
        await navigator.clipboard.writeText(button.dataset.shareUrl!);
        label.textContent = 'Link copied';
        shareStatus.textContent = 'Post link copied to clipboard.';
      }
    } catch (error) {
      if (error instanceof DOMException && error.name === 'AbortError') return;
      shareStatus.dataset.error = 'true';
      shareStatus.textContent = 'Unable to share this post. Copy the link from your browser address bar.';
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .article-share {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .article-share-button:not([hidden]) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text-primary);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .article-share-button:hover {
    color: var(--text-muted);
  }

  .article-share-button:focus-visible {
    outline: 2px solid var(--accent-hover);
    outline-offset: 4px;
  }

  .article-share-button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .share-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .share-status[data-error] {
    position: static;
    width: auto;
    height: auto;
    clip-path: none;
    color: var(--accent-hover);
    font-size: 0.8125rem;
    white-space: normal;
  }

  @media print {
    .article-share {
      display: none;
    }
  }
</style>
