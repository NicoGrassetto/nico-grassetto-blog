---
import { formatDate } from '../utils/formatDate';
import { Image } from 'astro:assets';

export interface Props {
  title: string;
  date: string;
  slug: string;
  image?: ImageMetadata;
  views?: number;
}

const { title, date, slug, image, views } = Astro.props;
---

<a href={`${import.meta.env.BASE_URL}blog/${slug}`} class="blog-post-card">
  <div class="card-content">
    <h3 class="card-title">{title}</h3>
    <div class="card-meta">
      <span class="card-date">{formatDate(date)}</span>
      {views !== undefined && (
        <span class="card-views">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          {views >= 1000 ? `${(views / 1000).toFixed(1)}K` : views}
        </span>
      )}
    </div>
  </div>
</a>

<style>
  .blog-post-card {
    display: block;
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: transform 0.2s ease;
  }

  .blog-post-card:hover {
    transform: translateY(-2px);
  }

  .blog-post-card:hover .card-title {
    color: var(--link-hover);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    background-color: var(--bg-secondary);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-post-card:hover .card-image img {
    transform: scale(1.02);
  }

  .card-content {
    padding: 0;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 0.25rem 0;
    line-height: 1.4;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .card-date {
    color: var(--text-muted);
  }

  .card-views {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--text-muted);
  }

  .card-views svg {
    opacity: 0.7;
  }
</style>
