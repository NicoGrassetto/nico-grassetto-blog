---
interface Deployment {
  name: string;
  ptus: number;
}

interface Props {
  total?: number;
  region?: string;
  deployments?: Deployment[];
}

const {
  total = 500,
  region = 'a region',
  deployments = [
    { name: 'GPT-4.1', ptus: 200 },
    { name: 'DeepSeek-R1', ptus: 100 },
  ],
} = Astro.props;

const used = deployments.reduce((sum, d) => sum + d.ptus, 0);
const free = Math.max(total - used, 0);
---

<figure class="quota-diagram">
  <div class="qd-frame">
    <div class="qd-head">
      <div class="qd-title"><b>quota</b> — total allowance in {region} · e.g. {total} PTUs</div>
      <div class="qd-sub">per subscription · per region · per deployment type</div>
    </div>

    <div
      class="qd-bar"
      role="img"
      aria-label={`Quota of ${total} PTUs in ${region}: ${used} deployed, ${free} available`}
    >
      {deployments.map((d) => (
        <div class="qd-seg qd-seg--used" style={`flex-grow:${d.ptus};`}>
          <span class="qd-seg-name">{d.name}</span>
          <span class="qd-seg-ptus">{d.ptus} PTU</span>
          <span class="qd-seg-tag">deployed</span>
        </div>
      ))}

      {free > 0 && (
        <div class="qd-seg qd-seg--free" style={`flex-grow:${free};`}>
          <span class="qd-seg-name">available</span>
          <span class="qd-seg-ptus">{free} PTU</span>
          <span class="qd-seg-tag">headroom</span>
        </div>
      )}
    </div>

    <div class="qd-axis">
      <span>0</span>
      <span>{total} PTU · quota ceiling</span>
    </div>
  </div>
  <figcaption class="quota-caption">
    The dashed box is your quota ceiling ({total} PTU). Solid blocks are deployed PTUs ({used}); the empty space is free headroom ({free}) you can deploy anytime — quota itself is free, you only pay for PTUs you deploy.
  </figcaption>
</figure>

<style>
  .quota-diagram {
    margin: 2rem 0;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-primary, #222);
    border-bottom: 1px solid var(--border-primary, #222);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .qd-frame {
    width: 100%;
    max-width: 720px;
  }

  .qd-head {
    text-align: center;
    margin-bottom: 1rem;
  }

  .qd-title {
    font-size: 0.95rem;
    color: var(--text-primary, #fff);
    letter-spacing: 0.03em;
  }

  .qd-title b {
    font-weight: 700;
  }

  .qd-sub {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    color: var(--text-muted, #888);
    letter-spacing: 0.04em;
  }

  .qd-bar {
    display: flex;
    gap: 2px;
    min-height: 128px;
    padding: 3px;
    border: 1px dashed var(--text-muted, #888);
    border-radius: 3px;
  }

  .qd-seg {
    flex-basis: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.3rem;
    padding: 0.75rem 0.5rem;
    overflow: hidden;
  }

  .qd-seg--used {
    background: var(--text-primary, #fff);
    color: var(--bg-primary, #000);
    border-radius: 2px;
  }

  .qd-seg--free {
    color: var(--text-muted, #888);
  }

  .qd-seg-name {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .qd-seg-ptus {
    font-size: 0.82rem;
    opacity: 0.85;
  }

  .qd-seg-tag {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .qd-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.55rem;
    font-size: 0.74rem;
    color: var(--text-muted, #888);
    letter-spacing: 0.03em;
  }

  .quota-caption {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-muted, #888);
    text-align: center;
    letter-spacing: 0.02em;
    max-width: 720px;
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    .qd-bar {
      flex-direction: column;
      min-height: 0;
    }
    .qd-seg {
      min-height: 56px;
      flex-direction: row;
      justify-content: space-between;
      gap: 0.6rem;
      padding: 0.6rem 0.9rem;
    }
    .qd-seg-tag {
      display: none;
    }
  }
</style>
