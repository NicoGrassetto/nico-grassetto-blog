---
export interface Props {
  title?: string;
}

const { title = 'References' } = Astro.props;
---

<section class="references">
  <h2>{title}</h2>
  <div class="references-list">
    <slot />
  </div>
</section>

<style>
  .references {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }
  
  .references h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }
  
  .references-list {
    display: flex;
    flex-direction: column;
  }
</style>
