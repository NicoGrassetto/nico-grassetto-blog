---
export interface Props {
  /** SVG width in pixels */
  width?: number;
  /** SVG height in pixels */
  height?: number;
  /** Total number of toll booths in the row */
  booths?: number;
  /** How many of those booths are open (rest are closed) */
  open?: number;
  /** Approx. number of cars per open-booth lane */
  carsPerOpenLane?: number;
  /** Approx. number of cars per closed-booth lane (usually 0 or 1) */
  carsPerClosedLane?: number;
  /** Unique id (allow multiple instances per page) */
  id?: string;
  /** Optional caption shown under the figure */
  caption?: string;
}

const {
  width = 720,
  height = 300,
  booths = 5,
  open = 2,
  carsPerOpenLane = 6,
  carsPerClosedLane = 0,
  id = `toll-booths-${Math.random().toString(36).slice(2, 9)}`,
  caption,
} = Astro.props;
---

<figure class="toll-booths">
  <svg
    id={id}
    class="toll-booths-svg"
    width={width}
    height={height}
    viewBox={`0 0 ${width} ${height}`}
    data-booths={booths}
    data-open={open}
    data-cars-open={carsPerOpenLane}
    data-cars-closed={carsPerClosedLane}
    aria-label="A row of toll booths with most closed and cars queueing behind the open ones"
    role="img"
  ></svg>
  {caption && <figcaption class="toll-booths-caption">{caption}</figcaption>}
</figure>

<script>
  async function loadD3(): Promise<any> {
    if ((window as any).d3) return (window as any).d3;
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js';
      s.onload = () => resolve((window as any).d3);
      s.onerror = () => reject(new Error('Failed to load D3.js'));
      document.head.appendChild(s);
    });
  }

  function readThemeColors(svgEl: SVGSVGElement) {
    const cs = getComputedStyle(svgEl);
    return {
      stroke: cs.getPropertyValue('--tb-stroke').trim() || '#888888',
      fill: cs.getPropertyValue('--tb-fill').trim() || '#ffffff',
      warn: cs.getPropertyValue('--tb-warn').trim() || '#e0853a',
    };
  }

  async function initTollBooths(svgEl: SVGSVGElement) {
    const d3 = await loadD3();

    const W = svgEl.viewBox.baseVal.width;
    const H = svgEl.viewBox.baseVal.height;

    const boothCount = Number(svgEl.dataset.booths || 5);
    const openCount = Math.min(Number(svgEl.dataset.open || 2), boothCount);
    const carsOpen = Number(svgEl.dataset.carsOpen || 6);
    const carsClosed = Number(svgEl.dataset.carsClosed || 0);

    const svg = d3.select(svgEl);
    svg.selectAll('*').remove();
    const colors = readThemeColors(svgEl);

    // Layout
    const margin = { top: 22, right: 24, bottom: 30, left: 24 };
    const innerW = W - margin.left - margin.right;
    const boothY = margin.top + 12;
    const boothH = 44;
    const laneW = innerW / boothCount;
    const boothW = Math.min(laneW * 0.7, 70);
    const roadY = boothY + boothH + 4;
    const carW = Math.min(boothW * 0.6, 32);
    const carH = 14;
    const carGap = 6;
    const queueStartY = roadY + 16;

    const root = svg.append('g');

    // Plaza label
    root.append('text')
      .attr('x', margin.left)
      .attr('y', margin.top - 4)
      .attr('text-anchor', 'start')
      .attr('font-family', 'JetBrains Mono, monospace')
      .attr('font-size', 11)
      .attr('letter-spacing', '0.08em')
      .attr('fill', colors.stroke)
      .attr('class', 'tb-label')
      .text('toll plaza (capacity)');

    // Booths
    for (let i = 0; i < boothCount; i++) {
      const laneCX = margin.left + laneW * (i + 0.5);
      const isOpen = i < openCount;
      const boothX = laneCX - boothW / 2;

      root.append('rect')
        .attr('x', boothX)
        .attr('y', boothY)
        .attr('width', boothW)
        .attr('height', boothH)
        .attr('fill', 'none')
        .attr('stroke', isOpen ? colors.stroke : colors.warn)
        .attr('stroke-width', 1.25)
        .attr('opacity', isOpen ? 1 : 0.8)
        .attr('shape-rendering', 'crispEdges')
        .attr('class', isOpen ? 'tb-stroke' : 'tb-warn-stroke');

      // Roof tick (overhang on both sides)
      root.append('line')
        .attr('x1', boothX - 4)
        .attr('y1', boothY)
        .attr('x2', boothX + boothW + 4)
        .attr('y2', boothY)
        .attr('stroke', isOpen ? colors.stroke : colors.warn)
        .attr('stroke-width', 1.25)
        .attr('opacity', isOpen ? 1 : 0.8)
        .attr('shape-rendering', 'crispEdges')
        .attr('class', isOpen ? 'tb-stroke' : 'tb-warn-stroke');

      if (isOpen) {
        root.append('circle')
          .attr('cx', laneCX)
          .attr('cy', boothY + boothH / 2 - 4)
          .attr('r', 4)
          .attr('fill', colors.fill)
          .attr('class', 'tb-dot');
        root.append('text')
          .attr('x', laneCX)
          .attr('y', boothY + boothH - 8)
          .attr('text-anchor', 'middle')
          .attr('font-family', 'JetBrains Mono, monospace')
          .attr('font-size', 9)
          .attr('letter-spacing', '0.06em')
          .attr('fill', colors.stroke)
          .attr('class', 'tb-label')
          .text('open');
      } else {
        const cx = laneCX;
        const cy = boothY + boothH / 2 - 2;
        const r = 5;
        root.append('line')
          .attr('x1', cx - r).attr('y1', cy - r)
          .attr('x2', cx + r).attr('y2', cy + r)
          .attr('stroke', colors.warn)
          .attr('stroke-width', 1.25)
          .attr('opacity', 0.85)
          .attr('class', 'tb-warn-stroke');
        root.append('line')
          .attr('x1', cx - r).attr('y1', cy + r)
          .attr('x2', cx + r).attr('y2', cy - r)
          .attr('stroke', colors.warn)
          .attr('stroke-width', 1.25)
          .attr('opacity', 0.85)
          .attr('class', 'tb-warn-stroke');
        root.append('text')
          .attr('x', cx)
          .attr('y', boothY + boothH - 8)
          .attr('text-anchor', 'middle')
          .attr('font-family', 'JetBrains Mono, monospace')
          .attr('font-size', 9)
          .attr('letter-spacing', '0.06em')
          .attr('fill', colors.warn)
          .attr('class', 'tb-warn-label')
          .text('closed');
      }
    }

    // Road line under the booths
    root.append('line')
      .attr('x1', margin.left)
      .attr('y1', roadY)
      .attr('x2', W - margin.right)
      .attr('y2', roadY)
      .attr('stroke', colors.stroke)
      .attr('stroke-width', 1)
      .attr('shape-rendering', 'crispEdges')
      .attr('class', 'tb-stroke');

    // Dashed lane dividers below the road
    const queueAreaBottom = H - margin.bottom - 8;
    for (let i = 1; i < boothCount; i++) {
      const x = margin.left + laneW * i;
      root.append('line')
        .attr('x1', x).attr('y1', roadY + 2)
        .attr('x2', x).attr('y2', queueAreaBottom)
        .attr('stroke', colors.stroke)
        .attr('stroke-width', 1)
        .attr('stroke-dasharray', '3 5')
        .attr('opacity', 0.45)
        .attr('shape-rendering', 'crispEdges')
        .attr('class', 'tb-stroke');
    }

    // Cars
    function drawCar(cx: number, cy: number, opts: { dimmed?: boolean } = {}) {
      const op = opts.dimmed ? 0.55 : 1;
      root.append('rect')
        .attr('x', cx - carW / 2)
        .attr('y', cy - carH / 2)
        .attr('width', carW)
        .attr('height', carH)
        .attr('rx', 3)
        .attr('ry', 3)
        .attr('fill', 'none')
        .attr('stroke', colors.stroke)
        .attr('stroke-width', 1.1)
        .attr('opacity', op)
        .attr('class', 'tb-stroke');
      // Two small vertical ticks suggest a windshield + rear window
      root.append('line')
        .attr('x1', cx - carW * 0.18)
        .attr('y1', cy - carH / 2 + 1)
        .attr('x2', cx - carW * 0.18)
        .attr('y2', cy + carH / 2 - 1)
        .attr('stroke', colors.stroke)
        .attr('stroke-width', 1)
        .attr('opacity', op * 0.7)
        .attr('class', 'tb-stroke');
      root.append('line')
        .attr('x1', cx + carW * 0.18)
        .attr('y1', cy - carH / 2 + 1)
        .attr('x2', cx + carW * 0.18)
        .attr('y2', cy + carH / 2 - 1)
        .attr('stroke', colors.stroke)
        .attr('stroke-width', 1)
        .attr('opacity', op * 0.7)
        .attr('class', 'tb-stroke');
    }

    const carSlot = carH + carGap;
    const maxCarsPerLane = Math.max(1, Math.floor((queueAreaBottom - queueStartY) / carSlot));
    let maxOpenLaneCars = 0;

    for (let i = 0; i < boothCount; i++) {
      const laneCX = margin.left + laneW * (i + 0.5);
      const isOpen = i < openCount;
      const target = isOpen ? carsOpen : carsClosed;
      const n = Math.min(target, maxCarsPerLane);
      if (isOpen) maxOpenLaneCars = Math.max(maxOpenLaneCars, n);

      for (let j = 0; j < n; j++) {
        const cy = queueStartY + carSlot * j + carH / 2;
        // The very back of a long queue dims slightly to read as "waiting"
        const dimmed = isOpen && n - j <= 2 && n >= 4;
        drawCar(laneCX, cy, { dimmed });
      }
    }

    // Queue bracket spanning the open lanes
    if (openCount > 0 && maxOpenLaneCars > 0) {
      const bracketY = queueStartY + carSlot * maxOpenLaneCars + 2;
      const left = margin.left + 6;
      const right = margin.left + laneW * openCount - 6;
      root.append('path')
        .attr('d', `M ${left} ${bracketY - 4} L ${left} ${bracketY} L ${right} ${bracketY} L ${right} ${bracketY - 4}`)
        .attr('fill', 'none')
        .attr('stroke', colors.stroke)
        .attr('stroke-width', 1)
        .attr('class', 'tb-stroke');
      root.append('text')
        .attr('x', (left + right) / 2)
        .attr('y', bracketY + 14)
        .attr('text-anchor', 'middle')
        .attr('font-family', 'JetBrains Mono, monospace')
        .attr('font-size', 11)
        .attr('letter-spacing', '0.08em')
        .attr('fill', colors.stroke)
        .attr('class', 'tb-label')
        .text(`traffic backs up behind the ${openCount} open lane${openCount === 1 ? '' : 's'}`);
    }

    // "X / N booths open" status pinned to the top-right
    if (openCount < boothCount) {
      root.append('text')
        .attr('x', W - margin.right)
        .attr('y', margin.top - 4)
        .attr('text-anchor', 'end')
        .attr('font-family', 'JetBrains Mono, monospace')
        .attr('font-size', 11)
        .attr('letter-spacing', '0.08em')
        .attr('fill', colors.warn)
        .attr('class', 'tb-warn-label')
        .text(`${openCount}/${boothCount} booths open`);
    }

    // Theme toggle
    const themeObserver = new MutationObserver(() => {
      const c = readThemeColors(svgEl);
      svg.selectAll('.tb-stroke').attr('stroke', c.stroke);
      svg.selectAll('.tb-label').attr('fill', c.stroke);
      svg.selectAll('.tb-dot').attr('fill', c.fill);
      svg.selectAll('.tb-warn-stroke').attr('stroke', c.warn);
      svg.selectAll('.tb-warn-label').attr('fill', c.warn);
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }

  function initAll() {
    document.querySelectorAll<SVGSVGElement>('svg.toll-booths-svg').forEach((el) => {
      initTollBooths(el).catch((err) => console.error('TollBooths init failed', err));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>

<style>
  .toll-booths {
    margin: 2rem 0;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-primary, #222);
    border-bottom: 1px solid var(--border-primary, #222);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .toll-booths-svg {
    --tb-stroke: var(--text-muted, #888);
    --tb-fill: var(--text-primary, #fff);
    --tb-warn: #e0853a;
    max-width: 100%;
    height: auto;
    display: block;
  }

  .toll-booths-caption {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-muted, #888);
    text-align: center;
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }
</style>
