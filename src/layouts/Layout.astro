---
import 'katex/dist/katex.min.css';

export interface Props {
	title?: string;
	description?: string;
	fullWidth?: boolean;
}

const { title = "Nico Grassetto's Blog", description = "Engineering experiences with technologies.", fullWidth = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="Nico Grassetto" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Nico Grassetto" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:creator" content="@ngrassetto" />
		
		<!-- RSS Feed -->
		<link rel="alternate" type="application/rss+xml" title="Nico Grassetto's Blog" href="/feed" />

		<!-- JetBrains Mono Font -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
		
		<!-- Prevent flash of unstyled content -->
		<script>
			(function() {
				function getInitialTheme() {
					const savedTheme = localStorage.getItem('theme');
					if (savedTheme) return savedTheme;
					if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
						return 'light';
					}
					return 'dark';
				}
				document.documentElement.setAttribute('data-theme', getInitialTheme());
			})();
		</script>

		<title>{title}</title>
	</head>
	<body>
		<div class={fullWidth ? "container-full" : "container"}>
			<main>
				<slot />
			</main>
		</div>
		<script>
			// Theme toggle functionality
			const themeToggle = document.getElementById('theme-toggle');
			const html = document.documentElement;
			
			// Function to get initial theme
			function getInitialTheme() {
				// Check for saved theme preference
				const savedTheme = localStorage.getItem('theme');
				if (savedTheme) {
					return savedTheme;
				}
				
				// Check system preference
				if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
					return 'light';
				}
				
				// Default to dark
				return 'dark';
			}
			
			// Set initial theme
			const initialTheme = getInitialTheme();
			html.setAttribute('data-theme', initialTheme);
			
			// Listen for system theme changes
			if (window.matchMedia) {
				window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
					// Only auto-switch if user hasn't manually set a preference
					if (!localStorage.getItem('theme')) {
						const newTheme = e.matches ? 'light' : 'dark';
						html.setAttribute('data-theme', newTheme);
					}
				});
			}
			
			// Theme toggle click handler
			themeToggle?.addEventListener('click', () => {
				const currentTheme = html.getAttribute('data-theme');
				const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
				
				html.setAttribute('data-theme', newTheme);
				localStorage.setItem('theme', newTheme);
			});
		</script>
		<script is:inline type="module">
			const mermaidPres = document.querySelectorAll('pre[data-language="mermaid"]');
			if (mermaidPres.length > 0) {
				const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
				const theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'default' : 'dark';
				mermaid.initialize({ startOnLoad: false, theme });
				mermaidPres.forEach((pre) => {
					const code = pre.querySelector('code');
					const container = document.createElement('div');
					container.classList.add('mermaid');
					container.textContent = code ? code.textContent : pre.textContent;
					pre.replaceWith(container);
				});
				await mermaid.run({ nodes: document.querySelectorAll('.mermaid') });
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		/* Dark theme (default) - Pure black */
		--bg-primary: #000000;
		--bg-secondary: #0a0a0a;
		--text-primary: #ffffff;
		--text-secondary: #cccccc;
		--text-muted: #888888;
		--accent-primary: #ffffff;
		--accent-hover: #ff6b00;
		--border-primary: #222222;
		--border-secondary: #333333;
		--link-color: #ffffff;
		--link-hover: #ff6b00;
		--column-border: #1a1a1a;
	}

	[data-theme="light"] {
		/* Light theme */
		--bg-primary: #ffffff;
		--bg-secondary: #f8f9fa;
		--text-primary: #000000;
		--text-secondary: #333333;
		--text-muted: #666666;
		--accent-primary: #000000;
		--accent-hover: #ff6b00;
		--border-primary: #e0e0e0;
		--border-secondary: #d0d0d0;
		--link-color: #000000;
		--link-hover: #ff6b00;
		--column-border: #e8e8e8;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		font-family: 'JetBrains Mono', monospace;
		line-height: 1.6;
		color: var(--text-primary);
		background-color: var(--bg-primary);
		background-image: repeating-linear-gradient(
			0deg,
			transparent,
			transparent 1px,
			rgba(255, 255, 255, 0.03) 1px,
			rgba(255, 255, 255, 0.03) 2px
		);
		font-size: 16px;
		font-weight: 400;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	/* Lock scrolling only for full-width layout (homepage) */
	body:has(.container-full) {
		height: 100vh;
		overflow: hidden;
	}

	/* Allow scrolling for regular container (blog posts) */
	body:has(.container) {
		height: auto;
		overflow: auto;
	}

	/* Full-width container for 3-column layout */
	.container-full {
		width: 100%;
		height: 100vh;
		overflow: hidden;
	}

	.container-full main {
		height: 100vh;
		overflow: hidden;
	}

	/* Standard container for blog posts */
	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem;
		min-height: 100vh;
	}

	.container main {
		height: auto;
		overflow: visible;
	}

	/* Three-column grid */
	.three-column-grid {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		height: 100vh;
		width: 100%;
		overflow: hidden;
	}

	.column {
		display: flex;
		flex-direction: column;
		border-right: 1px solid var(--column-border);
		height: 100vh;
		overflow-y: auto;
		overflow-x: hidden;
		scrollbar-width: none; /* Firefox */
		-ms-overflow-style: none; /* IE/Edge */
	}

	.column::-webkit-scrollbar {
		display: none; /* Chrome/Safari/Opera */
	}

	.column:last-child {
		border-right: none;
	}

	.column-section {
		padding: 1.75rem 2rem;
		border-bottom: 1px solid var(--column-border);
	}

	.column-section:last-child {
		border-bottom: none;
		flex: 1;
	}

	/* Section headers - ALL CAPS, no underline */
	.section-header {
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 1.25rem;
	}

	/* Profile section */
	.profile-image {
		width: 85%;
		height: auto;
		aspect-ratio: auto;
		object-fit: cover;
		margin: 0 auto 1.5rem auto;
		display: block;
		filter: grayscale(20%);
	}

	.profile-bio {
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text-secondary);
	}

	.profile-bio strong {
		color: var(--text-primary);
		font-weight: 600;
	}

	/* Links section */
	.links-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.link-item {
		margin-bottom: 0.6rem;
	}

	.link-item a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--text-primary);
		text-decoration: none;
		font-size: 1rem;
		transition: color 0.2s ease;
	}

	.link-item a:hover {
		color: var(--link-hover);
	}

	.link-item svg {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
	}

	/* Blog posts column */
	.blog-posts-grid {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	/* Mobile responsive - stack columns */
	@media (max-width: 1024px) {
		.three-column-grid {
			grid-template-columns: 1fr 1fr;
		}
		
		.column:nth-child(3) {
			grid-column: 1 / -1;
			border-right: none;
			border-top: 1px solid var(--column-border);
		}
	}

	@media (max-width: 768px) {
		html, body {
			overflow: auto !important;
			height: auto !important;
		}

		.container-full {
			height: auto !important;
			overflow: visible !important;
		}

		main {
			height: auto !important;
			overflow: visible !important;
		}

		.three-column-grid {
			grid-template-columns: 1fr;
			height: auto;
			overflow: visible;
		}
		
		.column {
			border-right: none;
			border-bottom: 1px solid var(--column-border);
			min-height: auto;
			height: auto;
			overflow: visible;
		}

		.column:nth-child(3) {
			grid-column: auto;
			border-top: none;
		}

		.column:last-child {
			border-bottom: none;
		}

		.column-section {
			padding: 1.5rem;
		}

		.profile-image {
			width: 70%;
		}
	}

	/* Utility classes */
	a {
		color: var(--link-color);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	a:hover {
		color: var(--link-hover);
	}
</style>
