---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CodePanels from '../../components/CodePanels.astro';
import ArticleShare from '../../components/ArticleShare.astro';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  // In dev mode, show all posts including drafts; in production, filter them out
  const entries = import.meta.env.DEV 
    ? blogEntries 
    : blogEntries.filter((e) => !e.data.draft);
  return entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'blog'>;
};

const { entry } = Astro.props;
// Safety guard: in production, drafts should not be accessible
if (!import.meta.env.DEV && entry.data.draft) {
  throw new Response(null, { status: 404 });
}
const { Content } = await entry.render();

const bannerImage = entry.data.image;
const shareURL = new URL(`${import.meta.env.BASE_URL}blog/${entry.slug}`, Astro.site).href;
---

<Layout title={entry.data.title} description={null}>
  <CodePanels />
  <article class="blog-post">
    <header class="paper-header">
      <div class="post-meta">
        <time datetime={entry.data.date} class="paper-date">{formatDate(entry.data.date)}</time>
        {entry.data.tags.length > 0 && (
          <ul class="post-tags" aria-label="Tags">
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </div>
      <h1 class="paper-title">{entry.data.title}</h1>
      <div class="post-actions">
        <ArticleShare title={entry.data.title} url={shareURL} />
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>
    
    <footer class="post-footer">
      <a href={`${import.meta.env.BASE_URL}blog/`} class="back-link">← Back to Blog</a>
    </footer>
  </article>
</Layout>

<style>
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
  }

  .paper-header {
    position: relative;
    left: 50%;
    width: min(60rem, calc(100vw - 3rem));
    transform: translateX(-50%);
    text-align: center;
    margin-bottom: 3rem;
    padding-top: 3rem;
    font-family: Arial, Helvetica, sans-serif;
  }

  .post-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-bottom: 2rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .post-tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    list-style: none;
    color: var(--text-muted);
  }

  .paper-title {
    font-size: clamp(2rem, 7.5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.05;
    margin: 0;
    color: var(--text-primary);
    text-transform: none;
    letter-spacing: -0.035em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .post-actions {
    max-width: 41rem;
    margin: 5rem auto 0;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);
    text-align: start;
  }

  .post-content {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-primary);
    margin-bottom: 3rem;
  }

  .post-content :global(h1),
  .post-content :global(h2) {
    color: var(--text-muted);
    margin: 2rem 0 1rem 0;
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    color: var(--text-muted);
    margin: 1.5rem 0 0.75rem 0;
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .post-content :global(h2) {
    font-size: 0.875rem;
  }

  .post-content :global(h3) {
    font-size: 0.8rem;
  }

  .post-content :global(p) {
    margin: 1.5rem 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin: 0.35rem 0;
  }

  .post-content :global(.table-scroll) {
    --table-border-color: color-mix(in srgb, var(--text-primary) 12%, transparent);
    max-width: 100%;
    margin: 1.75rem 0;
    padding: 0.75rem 0;
    overflow-x: auto;
  }

  .post-content :global(.table-scroll:focus-visible) {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  .post-content :global(.table-scroll table) {
    width: 100%;
    border-collapse: collapse;
    color: var(--text-primary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-content :global(.table-scroll th),
  .post-content :global(.table-scroll td) {
    min-width: 7.5rem;
    padding: 0.75rem;
    border: 1px solid var(--table-border-color);
    overflow-wrap: break-word;
    text-align: start;
    vertical-align: top;
  }

  .post-content :global(.table-scroll th) {
    font-weight: 600;
  }

  .post-content :global(pre) {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--border-primary);
    font-size: 0.85rem;
    break-inside: avoid;
  }

  .post-content :global(code) {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 0.875rem;
  }

  .post-content :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--border-primary);
    margin: 2rem 0;
    padding: 1rem 2rem;
    background: var(--bg-secondary);
    font-style: italic;
  }

  .post-content :global(a) {
    color: var(--link-color);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .post-content :global(a:hover) {
    color: var(--link-hover);
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-primary);
  }

  .back-link {
    color: var(--link-color);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .post-content {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .paper-header {
      margin-bottom: 2rem;
      padding-top: 1.5rem;
    }

    .post-actions {
      margin-top: 3rem;
    }
  }
</style>
