---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  // In dev mode, show all posts including drafts; in production, filter them out
  const entries = import.meta.env.DEV 
    ? blogEntries 
    : blogEntries.filter((e) => !e.data.draft);
  return entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'blog'>;
};

const { entry } = Astro.props;
// Safety guard: in production, drafts should not be accessible
if (!import.meta.env.DEV && entry.data.draft) {
  throw new Response(null, { status: 404 });
}
const { Content } = await entry.render();

const bannerImage = entry.data.image;
---

<Layout title={entry.data.title} description={null}>  <article class="blog-post">
    <!-- Scientific Paper Style Header -->
    <header class="paper-header">
      <h1 class="paper-title">{entry.data.title}</h1>
      <div class="paper-meta">
        <div class="paper-author">Nico Grassetto</div>
        <div class="paper-affiliation">AI Apps Solutions Engineer</div>
        <div class="paper-contact">ngrassetto@microsoft.com</div>
      </div>
      <div class="paper-date">
        <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time>
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>
    
    <footer class="post-footer">
      <a href={`${import.meta.env.BASE_URL}blog/`} class="back-link">← Back to Blog</a>
    </footer>
  </article>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-code-examples]').forEach((group) => {
    const buttons = group.querySelectorAll<HTMLButtonElement>('[data-code-switcher] button');
    const examples = group.querySelectorAll<HTMLElement>('[data-code-example]');

    function selectLanguage(language: string) {
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.value === language));
      });
      examples.forEach((example) => {
        example.hidden = example.dataset.codeExample !== language;
      });
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => selectLanguage(button.value));
    });
    selectLanguage(buttons[0].value);
    group.querySelectorAll<HTMLElement>('[data-code-switcher]').forEach((switcher) => {
      switcher.hidden = false;
    });
  });
</script>

<style>
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
  }

  /* Scientific Paper Header Styles */
  .paper-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-primary);
  }

  .paper-title {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 1.5rem 0;
    color: var(--text-primary);
    text-transform: none;
    letter-spacing: normal;
  }

  .paper-meta {
    margin-bottom: 1rem;
  }

  .paper-author {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .paper-affiliation {
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-style: italic;
    margin-bottom: 0.25rem;
  }

  .paper-contact {
    font-size: 0.85rem;
    color: var(--link-color);
  }

  .paper-date {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 1rem;
  }

  .post-content {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-primary);
    margin-bottom: 3rem;
  }

  .post-content :global(h1),
  .post-content :global(h2) {
    color: var(--text-muted);
    margin: 2rem 0 1rem 0;
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    color: var(--text-muted);
    margin: 1.5rem 0 0.75rem 0;
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .post-content :global(h2) {
    font-size: 0.875rem;
  }

  .post-content :global(h3) {
    font-size: 0.8rem;
  }

  .post-content :global(p) {
    margin: 1.5rem 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin: 0.35rem 0;
  }

  .post-content :global(.table-scroll) {
    --table-border-color: color-mix(in srgb, var(--text-primary) 12%, transparent);
    max-width: 100%;
    margin: 1.75rem 0;
    padding: 0.75rem 0;
    overflow-x: auto;
  }

  .post-content :global(.table-scroll:focus-visible) {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  .post-content :global(.table-scroll table) {
    width: 100%;
    border-collapse: collapse;
    color: var(--text-primary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-content :global(.table-scroll th),
  .post-content :global(.table-scroll td) {
    min-width: 7.5rem;
    padding: 0.75rem;
    border: 1px solid var(--table-border-color);
    overflow-wrap: break-word;
    text-align: start;
    vertical-align: top;
  }

  .post-content :global(.table-scroll th) {
    font-weight: 600;
  }

  .post-content :global(pre) {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--border-primary);
    font-size: 0.85rem;
    break-inside: avoid;
  }

  .post-content :global(code) {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 0.875rem;
  }

  .post-content :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
  }

  .post-content :global([data-code-switcher]:not([hidden])) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 1rem;
  }

  .post-content :global([data-code-switcher] button) {
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-secondary);
    border-radius: 4px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .post-content :global([data-code-switcher] button:hover) {
    border-color: var(--text-primary);
  }

  .post-content :global([data-code-switcher] button[aria-pressed="true"]) {
    background: var(--text-primary);
    color: var(--bg-primary);
    border-color: var(--text-primary);
  }

  .post-content :global([data-code-switcher] button:focus-visible) {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--border-primary);
    margin: 2rem 0;
    padding: 1rem 2rem;
    background: var(--bg-secondary);
    font-style: italic;
  }

  .post-content :global(a) {
    color: var(--link-color);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .post-content :global(a:hover) {
    color: var(--link-hover);
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-primary);
  }

  .back-link {
    color: var(--link-color);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .paper-title {
      font-size: 1.4rem;
    }

    .paper-author {
      font-size: 1rem;
    }

    .post-content {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .paper-title {
      font-size: 1.25rem;
    }

    .paper-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
    }
  }
</style>
