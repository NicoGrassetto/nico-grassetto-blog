---
import { getPublishedPosts } from '../utils/getPublishedPosts';

const [latestPost] = await getPublishedPosts();
const title = 'Nico Grassetto | Ideas into action';
const description = 'Nico Grassetto. A curious mind, a hands-on approach. Work, ideas, and new possibilities.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <meta name="author" content="Nico Grassetto">
    <meta name="generator" content={Astro.generator}>
    <meta name="theme-color" content="#000000">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:site_name" content="Nico Grassetto">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:creator" content="@ngrassetto">
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="canonical" href={new URL('/', Astro.site)}>
    <link rel="alternate" type="application/rss+xml" title="Nico Grassetto's Blog" href="/feed">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/styles.css">
    <script is:inline src="/assets/lucide.min.js" defer></script>
    <script is:inline src="/assets/three.js" defer></script>
    <script is:inline src="/assets/distributed-system.js" defer></script>
    <script is:inline src="/assets/pixel-landmarks.js" defer></script>
    <script is:inline src="/assets/config.js" defer></script>
    <script is:inline src="/assets/site.js" defer></script>
  </head>
  <body style={latestPost ? undefined : '--announcement-height: 0px;'}>
    <a class="skip-link" href="#main">Skip to content</a>
    {latestPost && (
      <aside class="announcement-bar" aria-label="Latest blog post">
        <a class="announcement-link" href={`${import.meta.env.BASE_URL}blog/${latestPost.slug}`} aria-label={`Read ${latestPost.data.title}`}>
          <span class="announcement-label">New post</span>
          <span class="announcement-title">{latestPost.data.title}</span>
          <span class="announcement-action">Read now <i data-lucide="arrow-up-right" aria-hidden="true"></i></span>
        </a>
      </aside>
    )}
    <header class="site-header">
      <a class="wordmark" href="#home" aria-label="Nico Grassetto, home">nico grassetto<span class="brand-dot" aria-hidden="true">.</span></a>
      <button class="menu-toggle icon-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav" title="Open menu">
        <i class="menu-open-icon" data-lucide="menu" aria-hidden="true"></i>
        <i class="menu-close-icon" data-lucide="x" aria-hidden="true"></i>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="Main navigation">
        <a href="#home" aria-current="location">Home</a>
        <a href="#case-studies">Case studies</a>
        <a href="#offers">Services</a>
        <a href="#contact">Contact</a>
        <a href={`${import.meta.env.BASE_URL}blog/`}>Blog</a>
      </nav>
      <a class="header-cta" href="#contact">Let's talk <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
    </header>

    <main id="main">
      <section class="hero" id="home" aria-labelledby="hero-title">
        <div class="systems-stage" role="img" aria-label="A branching pixel neural network with traveling impulses and intermittent coordinate tracking">
          <pre class="systems-fallback" aria-hidden="true">        \ | /                  \ | /
    .---- o ----.         .---- o ----.
   /     /|\     \       /     /|\
  /               \     /         \
 \|/              \ | /           \|/
-- o -------------- o ------------- o --
 /|\              / | \           /|\
   \              /   \            /
    \      \ | / /     \ \ | /    /
     '------ o --'     '-- o -----'
            /|\           /|\
           /   \         /   \</pre>
          <canvas class="systems-canvas" aria-hidden="true"></canvas>
          <svg class="neural-tracking" aria-hidden="true"></svg>
        </div>
        <div class="hero-content">
          <h1 id="hero-title">Artificial Intelligence Without the Bullsh**.</h1>
          <p class="hero-intro">Distributed systems, artificial intelligence, and automation done the right way.</p>
          <p class="hero-intro">My mission is to help companies build reliable and value-driven automation systems or products.</p>
          <a class="button button-primary" href="#case-studies">Explore work <i data-lucide="arrow-down-right" aria-hidden="true"></i></a>
        </div>
      </section>

      <section class="stats-strip section-shell" aria-label="In numbers">
